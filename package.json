{
  "name": "waterwolf-browser",
  "description": "WaterWolf desktop browser by Lyriq",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron .",
    "test:desktop": "node --test test/*.cjs",
    "pack:win": "npm run build && electron-builder --win portable --x64",
    "pack:win:installer": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "tech.lyriq.waterwolf",
    "productName": "WaterWolf",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/waterwolf-icon.*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lyriqtech-oss",
        "repo": "waterwolf",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "public/waterwolf-icon.ico",
      "target": "portable"
    },
    "portable": {
      "artifactName": "WaterWolf-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "WaterWolf-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WaterWolf"
    }
  }
}
